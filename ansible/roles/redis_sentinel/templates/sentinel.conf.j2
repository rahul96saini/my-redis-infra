port {{ sentinel_port }}
daemonize yes
pidfile /var/run/redis/redis-sentinel.pid
logfile /var/log/redis/redis-sentinel.log
dir /var/lib/redis

# Monitor the primary Redis master
sentinel monitor mymaster {{ hostvars[groups['role_redis_node'][0]]['ansible_internal_ip'] | default(groups['role_redis_node'][0]) }} {{ redis_port }} 2
sentinel down-after-milliseconds mymaster 5000
sentinel failover-timeout mymaster 60000
sentinel auth-epoch mymaster 0