port {{ sentinel_port }}
daemonize yes
pidfile /run/redis/redis-sentinel.pid
logfile /var/log/redis/redis-sentinel.log
dir /var/lib/redis

# Monitor the primary Redis master
sentinel monitor mymaster {{ hostvars[groups['role_redis_node'][0]]['private_ip_address'] }} {{ redis_port }} 2
sentinel down-after-milliseconds mymaster 5000
sentinel failover-timeout mymaster 60000