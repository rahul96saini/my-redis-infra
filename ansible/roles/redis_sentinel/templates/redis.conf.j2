bind 0.0.0.0
protected-mode no
port {{ redis_port }}
daemonize yes
pidfile /var/run/redis/redis-server.pid
loglevel notice
logfile /var/log/redis/redis-server.log
dir /var/lib/redis

# If this is not the first node, configure it as a replica of the first node in the inventory
{% if inventory_hostname != groups['role_redis_node'][0] %}
replicaof {{ hostvars[groups['role_redis_node'][0]]['ansible_internal_ip'] | default(groups['role_redis_node'][0]) }} {{ redis_port }}
{% endif %}